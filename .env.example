# Canonical production origin; add only explicit preview origins when needed.
APP_ORIGIN=https://www.steermeright.com
ALLOWED_ORIGINS=

# Pooled PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_MAX_CONNECTIONS=1

# Keep test and live Stripe environments fully separate.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# The retired consultation link is not used for new purchases.
# Set true during the coordinated offer cutover; paid fulfillment remains available.
CHECKOUT_PAUSED=false
STRIPE_PAYMENT_LINK_FULL_SERVICE_URL=https://buy.stripe.com/REPLACE_ME
STRIPE_PAYMENT_LINK_CONCIERGE_URL=https://buy.stripe.com/REPLACE_ME

# Optional anti-spam and downstream delivery.
TURNSTILE_SECRET_KEY=
LEAD_FORWARD_URL=
LEAD_FORWARD_BEARER_TOKEN=

# Paid intakes are emailed to Mason through Zoho SMTP (smtppro.zoho.com:465).
# Use the mailbox address and a Zoho app-specific password. Unset = intakes queue unsent.
INTAKE_SMTP_USER=
INTAKE_SMTP_PASSWORD=
INTAKE_EMAIL_TO=mason@steermeright.com

# Optional consent-approved server-side analytics collector.
ANALYTICS_FORWARD_URL=
ANALYTICS_FORWARD_BEARER_TOKEN=
ANALYTICS_OUTBOX_BATCH_SIZE=10
ANALYTICS_OUTBOX_LEASE_SECONDS=60
ANALYTICS_OUTBOX_MAX_ATTEMPTS=8
ANALYTICS_OUTBOX_RETRY_SECONDS=30
ANALYTICS_FORWARD_TIMEOUT_MS=5000
