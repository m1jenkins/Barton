{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "austincarbuyingservice.com"
        }
      ],
      "destination": "https://www.driverightcarbuying.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.austincarbuyingservice.com"
        }
      ],
      "destination": "https://www.driverightcarbuying.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "driverightcarbuying.com"
        }
      ],
      "destination": "https://www.driverightcarbuying.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inquiry.html",
      "destination": "/schedule.html",
      "permanent": true
    },
    {
      "source": "/blog-dealer-addons-exposed.html",
      "destination": "/blog-dealership-addons-complete-guide.html",
      "permanent": true
    },
    {
      "source": "/blog-roi-car-buying-service.html",
      "destination": "/how-it-works.html",
      "permanent": true
    },
    {
      "source": "/blog-flat-fees-vs-commissions.html",
      "destination": "/how-it-works.html",
      "permanent": true
    },
    {
      "source": "/blog-zero-kickbacks-promise.html",
      "destination": "/how-it-works.html",
      "permanent": true
    },
    {
      "source": "/blog-skip-dealership-marathon.html",
      "destination": "/how-it-works.html",
      "permanent": true
    }
  ]
}
