    {
      "source": "/pricing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/schedule.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/schedule",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/deal/:token/photo/:rank/:n",
      "destination": "/api/deal-tracker?t=:token&photo=:rank.:n"
    },
    {
      "source": "/deal/:token",
      "destination": "/api/deal-tracker?t=:token"
    }
  ],
  "crons": [
    {
      "path": "/api/outbox-dispatch",
      "schedule": "17 14 * * *"
    }
  ]
}
