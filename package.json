{
  "name": "drive-right-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:api": "node scripts/check-javascript.mjs --api",
    "check:js": "node scripts/check-javascript.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "test": "node --test api/_tests/*.test.mjs buying/*.test.js scripts/_tests/*.test.mjs",
    "test:buying": "node --test buying/*.test.js",
    "preview": "node scripts/preview.mjs",
    "check:buying": "node scripts/check-javascript.mjs --frontend && node scripts/validate-site.mjs",
    "draft:metros": "node scripts/render-metro-drafts.mjs",
    "preview:metros": "node scripts/preview-metros.mjs",
    "check:metros": "node scripts/render-metro-drafts.mjs --check",
    "draft:cities": "node scripts/render-city-pages.mjs",
    "preview:cities": "node scripts/preview-cities.mjs",
    "check:cities": "node --check scripts/preview-cities.mjs && node scripts/render-city-pages.mjs --check",
    "analytics:dispatch": "node scripts/dispatch-analytics.mjs",
    "leads:dispatch": "node scripts/dispatch-leads.mjs",
    "preview:worksheet": "node scripts/preview-worksheet.mjs",
    "preview:guides": "node scripts/preview-guides.mjs"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "parse5": "^8.0.1",
    "sharp": "^0.35.4"
  }
}
